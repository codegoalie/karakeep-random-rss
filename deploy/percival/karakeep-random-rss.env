# Env file for the `karakeep-random-rss` git-backed dockhand stack.
#
# THIS FILE IS THE DEPLOY TRIGGER. dockhand polls this repo on a cron
# (see deploy/README.md) and loads this file as the stack's env file.
# Bumping the version below and pushing IS how a release is rolled out —
# there is no separate "set it in the dockhand UI" step for this value.
#
# Do NOT put secrets in this file: it is committed, so it is only ever as
# private as the repo hosting it — and a dockhand git stack works just as
# well from a public GitHub repo as from the private soft-serve server on
# percival, so don't rely on the remote staying private.
# KARAKEEP_API_KEY is supplied as a dockhand stack variable instead
# (encrypted in dockhand's DB), never committed here.

KARAKEEP_RANDOM_RSS_VERSION=v0.2.0
KARAKEEP_URL=http://karakeep-web-1:3000
PUBLIC_URL=http://karakeep-random-rss:8080/feed.xml
INTERVAL=168h
FEED_ITEMS=50
FEED_TITLE=Karakeep: a random link

# IMPORTANT: KARAKEEP_RANDOM_RSS_VERSION must NEVER also be set as a dockhand
# stack variable for this stack. dockhand's variable precedence is: repo env
# file → dockhand stack variables → deploy-time env (later wins). If
# KARAKEEP_RANDOM_RSS_VERSION is set as a stack variable, it will silently
# override every future version bump committed here, so releases won't deploy.
# Set only in this file, never in the dockhand UI.
