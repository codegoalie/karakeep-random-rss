# Copy to .env and fill in. Every value here has a matching -flag.

# Required: your Karakeep instance and an API key from Settings > API Keys.
KARAKEEP_URL=https://karakeep.example.com
KARAKEEP_API_KEY=ak1_xxxxxxxxxxxxxxxx
# Alternative to the line above, for Docker/systemd secrets:
#KARAKEEP_API_KEY_FILE=/run/secrets/karakeep_api_key

# How often a new random link is published. Any Go duration: 24h, 8h, 168h.
INTERVAL=24h

# Where to listen, and the URL Miniflux will use (for the atom self-link).
LISTEN=:8080
PUBLIC_URL=http://localhost:8080/feed.xml

# Where the seen-set and published items are stored. Must persist across restarts.
STATE_FILE=./state.json

# Feed presentation.
FEED_TITLE=Karakeep: a random link
FEED_DESCRIPTION=One random bookmark from my Karakeep library, resurfaced on a schedule.
FEED_ITEMS=50

# Optional: narrow the pool to one list or tag. Leave unset for everything.
#LIST=Read Later
#TAG=longread

# Optional: set to enable POST /publish for an on-demand link.
#ADMIN_TOKEN=change-me
